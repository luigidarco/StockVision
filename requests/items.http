@baseUrl = http://localhost:8080
@itemId = 1

### List items
GET {{baseUrl}}/api/items

### Create item
POST {{baseUrl}}/api/items
Content-Type: application/json

{
  "name": "Teclado sem fio",
  "brand": "Acme",
  "categoryLabel": "Eletrônicos",
  "roomLocation": "Escritório",
  "description": "Wireless keyboard",
  "quantity": 10,
  "environmentProfile": {
    "id": 1
  },
  "subItems": [
    {
      "sequence": 1,
      "description": "Receptor USB",
      "quantity": 1
    }
  ]
}

### Get item
GET {{baseUrl}}/api/items/{{itemId}}

### Update item
PUT {{baseUrl}}/api/items/{{itemId}}
Content-Type: application/json

{
  "name": "Updated keyboard",
  "brand": "Acme",
  "categoryLabel": "Eletrônicos",
  "roomLocation": "Escritório",
  "description": "Mechanical keyboard",
  "quantity": 5,
  "environmentProfile": {
    "id": 1
  },
  "subItems": []
}

### Delete item
DELETE {{baseUrl}}/api/items/{{itemId}}